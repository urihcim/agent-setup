{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "language": "japanese",
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/glab-cli/config.yml)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Bash(gh auth *)",
      "Bash(npm login*)",
      "Bash(aws configure*)",
      "Bash(ssh-keygen*)"
    ]
  },
  "theme": "auto"
}
