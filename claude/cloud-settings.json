{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/latest-instructions.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/strip-pr-attribution.py"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_branch|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-branch-name.py"
          }
        ]
      }
    ]
  }
}
